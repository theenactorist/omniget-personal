+#[cfg(test)]
+mod personal_plugin_tests {
+    use super::*;
+
+    #[test]
+    fn plugin_update_preserves_the_users_enable_choice_and_install_date() {
+        for enabled in [false, true] {
+            let previous = InstalledPlugin {
+                id: "study".into(),
+                version: "1.0.0".into(),
+                installed_at: "2026-01-01T00:00:00Z".into(),
+                updated_at: "2026-01-01T00:00:00Z".into(),
+                enabled,
+                repo: None,
+                source_release: None,
+            };
+            let updated = plugin_install_record(
+                previous.id.clone(),
+                "1.1.0".into(),
+                "example/study".into(),
+                "v1.1.0".into(),
+                Some(&previous),
+            );
+            assert_eq!(updated.enabled, enabled);
+            assert_eq!(updated.installed_at, previous.installed_at);
+            assert_eq!(updated.version, "1.1.0");
+            assert_eq!(updated.source_release.as_deref(), Some("v1.1.0"));
+        }
+    }
+
+    #[test]
+    fn explicitly_installing_a_new_plugin_enables_it() {
+        let installed = plugin_install_record(
+            "convert".into(),
+            "1.0.0".into(),
+            "example/convert".into(),
+            "v1.0.0".into(),
+            None,
+        );
+        assert!(installed.enabled);
+        assert_eq!(installed.installed_at, installed.updated_at);
+    }
+}
