+    }
+
+    /// Encode a wait until `event` reaches at least `value`.
+    pub fn encode_wait_for_event(&self, event: &Event, value: u64) {
+        unsafe {
+            ffi::am_command_buffer_encode_wait_for_event(self.as_ptr(), event.as_ptr(), value);
+        };
