+        bytes_per_row: usize,
+        origin: (usize, usize),
+        size: (usize, usize),
+        mipmap_level: usize,
+    ) -> bool {
+        unsafe {
+            ffi::am_texture_get_bytes_2d(
+                self.as_ptr(),
+                out.as_mut_ptr(),
+                out.len(),
+                bytes_per_row,
+                origin.0,
+                origin.1,
+                size.0,
