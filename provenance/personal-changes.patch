+        };
+    }
+
+    /// Bind a visible function table at `index`.
+    pub fn set_visible_function_table(&self, table: &crate::VisibleFunctionTable, index: usize) {
+        unsafe {
+            ffi::am_compute_command_encoder_set_visible_function_table(
+                self.as_ptr(),
+                table.as_ptr(),
+                index,
+            );
+        };
