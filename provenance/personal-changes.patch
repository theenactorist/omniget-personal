+        unsafe {
+            ffi::am_texture_replace_region_2d(
+                self.as_ptr(),
+                origin.0,
+                origin.1,
+                size.0,
+                size.1,
+                mipmap_level,
+                bytes.as_ptr(),
+                bytes_per_row,
+            )
+        }
+    }
