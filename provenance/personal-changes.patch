+fn plugin_install_record(
+    plugin_id: String,
+    version: String,
+    repo: String,
+    source_release: String,
+    previous: Option<&InstalledPlugin>,
+) -> InstalledPlugin {
+    let now = chrono::Utc::now().to_rfc3339();
+    InstalledPlugin {
+        id: plugin_id,
+        version,
+        installed_at: previous.map_or_else(|| now.clone(), |p| p.installed_at.clone()),
+        updated_at: now,
+        // Updating a disabled plugin must not enable or execute it.
+        enabled: previous.is_none_or(|p| p.enabled),
+        repo: Some(repo),
+        source_release: Some(source_release),
+    }
